# সার্ভার
PORT=5000
NODE_ENV=development

# ডেটাবেস
MONGO_URI=mongodb://<user>:<password>@<host>:27017/power7?authSource=admin

# JWT — এই সিক্রেটটা এই ইনস্টলেশনের জন্য তৈরি করা, শেয়ার করবেন না
JWT_SECRET=<৬৪ অক্ষরের র‍্যান্ডম স্ট্রিং — `openssl rand -hex 32`>
JWT_EXPIRE=7d

# CORS — BetChokkor এর মতো সব অরিজিন খোলা (server/index.js এ app.use(cors()));
# API টোকেন-ভিত্তিক, কুকি নয় — তাই এখানে কিছু দিতে হয় না

# White-label master — গেমের ক্যাটালগ (TB) এখান থেকে আসে।
# API key .env এ নয়, অ্যাডমিন প্যানেলের "Add Game API Key" থেকে ডেটাবেসে বসে।
MASTER_API_URL=http://localhost:5005

# server এর public ঠিকানা — admin › Game Launch Key এ callback URL এটা দিয়েই
# দেখায় (খালি থাকলে যে ঠিকানা দিয়ে admin খোলা হয়েছে সেটা)
PUBLIC_SERVER_URL=https://api.example.com

# ঐচ্ছিক — শুধু এই IP গুলো থেকে গেমের callback নেওয়া হবে (কমা দিয়ে)
# CALLBACK_ALLOWED_IPS=1.2.3.4,5.6.7.8

# OraclePay — অটো ডিপোজিট ও অটো উত্তোলন। business token এখানে নয়,
# admin › Auto Deposit / Auto Withdraw থেকে ডেটাবেসে বসে।
OPAY_URL=https://api.oraclepay.org/api/opay-business/generate-payment-page
OPAY_WITHDRAW_URL=https://api.oraclepay.org/api/opay-business/auto-withdraw
# পেমেন্ট শেষে খেলোয়াড় কোথায় ফিরবে (ক্লায়েন্ট সাইটের ঠিকানা)
PUBLIC_CLIENT_URL=https://www.example.com

# notification চাপলে যে admin পাতা খোলে তার গোড়া
PUBLIC_ADMIN_URL=http://localhost:5175
